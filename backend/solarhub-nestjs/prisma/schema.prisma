generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id   Int    @id @default(autoincrement())
  name String

  code String?

  account_type String

  description String?

  is_active Boolean

  created_at DateTime

  updated_at DateTime

  company_id Int

  company          Company            @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journalEntryLine JournalEntryLine[]

  taxRecord TaxRecord[]

  @@unique([company_id, code], map: "accounting_account_company_id_code_528966f0_uniq")
  @@index([company_id], map: "accounting_account_company_id_6ef40338")
  @@map("accounting_account")
}

model Bill {
  id          Int    @id @default(autoincrement())
  bill_number String

  issue_date DateTime?

  due_date DateTime

  total_amount Decimal

  paid_amount Decimal

  status String

  created_at DateTime

  updated_at DateTime

  company_id Int

  journal_entry_id Int? @unique(map: "sqlite_autoindex_accounting_bill_1")
  supplier_id      Int?

  order_id     Int?          @unique(map: "sqlite_autoindex_accounting_bill_2")
  order        Order?        @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier     Supplier?     @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journalEntry JournalEntry? @relation(fields: [journal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company      Company       @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment      Payment[]

  @@index([supplier_id], map: "accounting_bill_supplier_id_20a5f730")
  @@index([company_id], map: "accounting_bill_company_id_5c0f4b62")
  @@map("accounting_bill")
}

model Invoice {
  id             Int      @id @default(autoincrement())
  invoice_number String   @unique(map: "sqlite_autoindex_accounting_invoice_1")
  issue_date     DateTime

  due_date DateTime

  total_amount Decimal

  paid_amount Decimal

  status String

  created_at DateTime

  updated_at DateTime

  company_id Int

  customer_id Int?

  journal_entry_id Int?          @unique(map: "sqlite_autoindex_accounting_invoice_2")
  order_id         Int?          @unique(map: "sqlite_autoindex_accounting_invoice_3")
  order            Order?        @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journalEntry     JournalEntry? @relation(fields: [journal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer         Customer?     @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company          Company       @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment          Payment[]

  @@index([customer_id], map: "accounting_invoice_customer_id_0c9566ed")
  @@index([company_id], map: "accounting_invoice_company_id_38eec83f")
  @@map("accounting_invoice")
}

model JournalEntry {
  id   Int      @id @default(autoincrement())
  date DateTime

  description String

  reference String?

  created_at DateTime

  updated_at DateTime

  company_id Int

  bill Bill?

  invoice Invoice?

  company          Company            @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  journalEntryLine JournalEntryLine[]

  payment Payment?

  payroll Payroll?

  expense Expense?

  @@index([company_id], map: "accounting_journalentry_company_id_9e360981")
  @@map("accounting_journalentry")
}

model JournalEntryLine {
  id          Int     @id @default(autoincrement())
  description String?

  debit Decimal

  credit Decimal

  account_id Int

  journal_entry_id Int

  journalEntry JournalEntry @relation(fields: [journal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  account      Account      @relation(fields: [account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([journal_entry_id], map: "accounting_journalentryline_journal_entry_id_78ed6ea5")
  @@index([account_id], map: "accounting_journalentryline_account_id_521eb404")
  @@map("accounting_journalentryline")
}

model Payment {
  id           Int    @id @default(autoincrement())
  payment_type String

  amount Decimal

  payment_date DateTime

  payment_method String

  reference String?

  created_at DateTime

  bill_id Int?

  company_id Int

  invoice_id Int?

  journal_entry_id Int?          @unique(map: "sqlite_autoindex_accounting_payment_1")
  journalEntry     JournalEntry? @relation(fields: [journal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice          Invoice?      @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company          Company       @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bill             Bill?         @relation(fields: [bill_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([invoice_id], map: "accounting_payment_invoice_id_18115c41")
  @@index([company_id], map: "accounting_payment_company_id_fd8a0641")
  @@index([bill_id], map: "accounting_payment_bill_id_e8a0a8c5")
  @@map("accounting_payment")
}

model Payroll {
  id           Int      @id @default(autoincrement())
  period_start DateTime

  period_end DateTime

  date_processed DateTime

  base_salary Decimal

  bonus Decimal

  deductions Decimal

  net_pay Decimal

  status String

  company_id Int

  employee_id Int

  journal_entry_id Int?          @unique(map: "sqlite_autoindex_accounting_payroll_1")
  journalEntry     JournalEntry? @relation(fields: [journal_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companyMember    CompanyMember @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company          Company       @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([employee_id], map: "accounting_payroll_employee_id_b527660a")
  @@index([company_id], map: "accounting_payroll_company_id_fffcb09b")
  @@map("accounting_payroll")
}

model TaxRecord {
  id       Int    @id @default(autoincrement())
  tax_name String

  tax_rate Decimal

  description String?

  company_id Int

  liability_account_id Int?

  account Account? @relation(fields: [liability_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company Company  @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([liability_account_id], map: "accounting_taxrecord_liability_account_id_57fec9f7")
  @@index([company_id], map: "accounting_taxrecord_company_id_025bc7d7")
  @@map("accounting_taxrecord")
}

model AppConfig {
  key   String  @id
  value Boolean

  description String?

  updated_at DateTime

  @@map("app_config_appconfig")
}

model City {
  id   Int    @id @default(autoincrement())
  code String

  created_at DateTime

  country_id Int

  name String

  country Country   @relation(fields: [country_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company Company[]

  offerRequest OfferRequest[]

  users User[]

  @@index([country_id], map: "app_config_city_country_id_876cedd6")
  @@map("app_config_city")
}

model Country {
  id         Int      @id @default(autoincrement())
  code       String   @unique(map: "sqlite_autoindex_app_config_country_1")
  created_at DateTime

  name String

  city City[]

  @@map("app_config_country")
}

model Currency {
  id   Int    @id @default(autoincrement())
  name String

  code String

  symbol String

  is_default Boolean

  created_at DateTime

  company Company[]

  @@map("app_config_currency")
}

model Feedback {
  id   Int    @id @default(autoincrement())
  name String

  phone_number Int?

  message String

  created_at DateTime

  is_read Boolean

  image String?

  @@map("app_config_feedback")
}

model GlobalCategory {
  id   Int     @id @default(autoincrement())
  name String  @unique(map: "sqlite_autoindex_app_config_globalcategory_1")
  icon String?

  product Product[]

  @@map("app_config_globalcategory")
}

model Notification {
  id    Int    @id @default(autoincrement())
  title String

  body String

  notification_type String

  is_read Boolean

  related_entity_type String?

  created_at DateTime

  user_id Int

  related_entity_id Int?

  user User @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "app_config_notification_user_id_49a1432f")
  @@map("app_config_notification")
}

model SubscriptionPlan {
  id   Int    @id @default(autoincrement())
  name String

  duration_days Int

  price Decimal

  description String?

  is_active Boolean

  created_at DateTime

  company Company[]

  companySubscriptionRequest CompanySubscriptionRequest[]

  companyType_allowed_subscription_plans company_companytype_allowed_subscription_plans[]

  @@map("app_config_subscriptionplan")
}

model Permission {
  id              Int @id @default(autoincrement())
  content_type_id Int

  codename String

  name String

  contentType     ContentType       @relation(fields: [content_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userPermissions UserPermissions[]

  @@unique([content_type_id, codename], map: "auth_permission_content_type_id_codename_01ab375a_uniq")
  @@index([content_type_id], map: "auth_permission_content_type_id_2f476e4b")
  @@map("auth_permission")
}

model User {
  id           Int       @id @default(autoincrement())
  password     String
  last_login   DateTime?
  is_superuser Boolean   @default(false)
  username     String    @unique
  first_name   String
  last_name    String
  email        String    @unique
  is_staff     Boolean   @default(false)
  is_active    Boolean   @default(true)
  date_joined  DateTime  @default(now())

  // --- Profile Fields ---
  language          String    @default("ar")
  phone             String?   @unique
  image             String?
  security_question String?
  security_answer   String?
  is_deleted        Boolean   @default(false)
  deleted_at        DateTime?
  deleted_reason    String?

  cityId Int?
  city   City? @relation(fields: [cityId], references: [id])

  // --- Relations ---
  companyMember              CompanyMember?
  notification               Notification[]
  userPermissions            UserPermissions[]
  comment                    Comment[]
  post                       Post[]
  adminLog                   AdminLog[]
  resetPasswordToken         ResetPasswordToken[]
  fCMDevice                  FCMDevice[]
  notificationMsg            NotificationMsg[]
  offers                     Offer[]
  offerRequests              OfferRequest[]
  customers                  Customer[]
  orders                     Order[]
  systems                    System[]
  companySubscriptionRequest CompanySubscriptionRequest[]

  // --- Multiple Relations ---
  reviewedServiceRequests  CompanyServiceRequest[]      @relation("company_companyservicerequest_reviewed_by_idToauth_user")
  requestedServiceRequests CompanyServiceRequest[]      @relation("company_companyservicerequest_requested_by_idToauth_user")
  requestedSubscriptions   CompanyServiceSubscription[] @relation("company_companyservicesubscription_requested_by_idToauth_user")
  approvedSubscriptions    CompanyServiceSubscription[] @relation("company_companyservicesubscription_approved_by_idToauth_user")

  @@map("auth_user")
}

model UserPermissions {
  id      Int @id @default(autoincrement())
  user_id Int

  permission_id Int

  permission Permission @relation(fields: [permission_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       User       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, permission_id], map: "auth_user_user_permissions_user_id_permission_id_14a6b632_uniq")
  @@index([permission_id], map: "auth_user_user_permissions_permission_id_1fbb5f2c")
  @@index([user_id], map: "auth_user_user_permissions_user_id_a95ead1b")
  @@map("auth_user_user_permissions")
}

model Comment {
  id      Int    @id @default(autoincrement())
  content String

  created_at DateTime

  author_id Int

  post_id Int

  post Post @relation(fields: [post_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user User @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([post_id], map: "community_comment_post_id_12b521a8")
  @@index([author_id], map: "community_comment_author_id_51c65c2a")
  @@map("community_comment")
}

model Post {
  id      Int     @id @default(autoincrement())
  content String?

  image String?

  post_type String

  likes_count Int

  created_at DateTime

  author_id Int?

  company_id Int?

  system_id Int?

  comment Comment[]

  system  System?  @relation(fields: [system_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company Company? @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    User?    @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([system_id], map: "community_post_system_id_3a588f79")
  @@index([company_id], map: "community_post_company_id_2b8a12df")
  @@index([author_id], map: "community_post_author_id_a6c5f564")
  @@map("community_post")
}

model Company {
  id   Int    @id @default(autoincrement())
  name String

  description String?

  logo String?

  address String?

  status String

  allows_b2b Boolean

  allows_b2c Boolean

  created_at DateTime

  updated_at DateTime

  expire_date DateTime

  currency_id Int?

  city_id Int?

  subscription_plan_id Int?

  subscription_start_date DateTime?

  company_type_id Int?

  phone String

  last_activation_reminder_at DateTime?

  account Account[]

  bill Bill[]

  invoice Invoice[]

  journalEntry JournalEntry[]

  payment Payment[]

  payroll Payroll[]

  taxRecord TaxRecord[]

  post Post[]

  companyType         CompanyType?          @relation(fields: [company_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriptionPlan    SubscriptionPlan?     @relation(fields: [subscription_plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  city                City?                 @relation(fields: [city_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currency            Currency?             @relation(fields: [currency_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companyServiceTypes CompanyServiceTypes[]

  companyCategory CompanyCategory[]

  companyMember CompanyMember[]

  companyService CompanyService[]

  companyServiceRequest CompanyServiceRequest[]

  companyServiceSubscription CompanyServiceSubscription[]

  companySubscriptionRequest CompanySubscriptionRequest[]

  companyWork CompanyWork[]

  contact Contact[]

  deliveryOption DeliveryOption[]

  expense Expense[]

  financialTransaction FinancialTransaction[]

  poster Poster[]

  involvementTemplate InvolvementTemplate[]

  offer Offer[]

  offerInvolvement OfferInvolvement[]

  customer_shop_customer_company_idTocompany_company       Customer[] @relation("shop_customer_company_idTocompany_company")
  customer_shop_customer_buyer_company_idTocompany_company Customer[] @relation("shop_customer_buyer_company_idTocompany_company")
  order_shop_order_seller_company_idTocompany_company      Order[]    @relation("shop_order_seller_company_idTocompany_company")
  order_shop_order_buyer_company_idTocompany_company       Order[]    @relation("shop_order_buyer_company_idTocompany_company")
  product                                                  Product[]

  supplier_shop_supplier_seller_company_idTocompany_company Supplier[] @relation("shop_supplier_seller_company_idTocompany_company")
  supplier_shop_supplier_company_idTocompany_company        Supplier[] @relation("shop_supplier_company_idTocompany_company")
  system                                                    System[]

  @@index([company_type_id], map: "company_company_company_type_id_fc43c4dc")
  @@index([subscription_plan_id], map: "company_company_subscription_plan_id_7b0155fd")
  @@index([city_id], map: "company_company_city_id_cbcb550b")
  @@index([currency_id], map: "company_company_currency_id_cf9daae5")
  @@map("company_company")
}

model CompanyServiceTypes {
  id         Int @id @default(autoincrement())
  company_id Int

  servicetype_id Int

  serviceType ServiceType @relation(fields: [servicetype_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company     Company     @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([company_id, servicetype_id], map: "company_company_service_types_company_id_servicetype_id_326d67e4_uniq")
  @@index([servicetype_id], map: "company_company_service_types_servicetype_id_ac48ad8e")
  @@index([company_id], map: "company_company_service_types_company_id_86d15421")
  @@map("company_company_service_types")
}

model CompanyCategory {
  id   Int    @id @default(autoincrement())
  name String

  created_at DateTime

  company_id Int

  company           Company             @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productCategories ProductCategories[]

  @@index([company_id], map: "company_companycategory_company_id_3fe4d005")
  @@map("company_companycategory")
}

model CompanyMember {
  id   Int    @id @default(autoincrement())
  role String

  joined_at DateTime

  company_id Int

  user_id Int       @unique(map: "sqlite_autoindex_company_companymember_1")
  payroll Payroll[]

  user    User    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([company_id], map: "company_companymember_company_id_49d1855c")
  @@map("company_companymember")
}

model CompanyService {
  id    Int    @id @default(autoincrement())
  title String

  price Decimal?

  description String?

  created_at DateTime

  updated_at DateTime

  company_id Int

  company Company @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([company_id], map: "company_companyservice_company_id_971a0610")
  @@map("company_companyservice")
}

model CompanyServiceCatalog {
  id   Int    @id @default(autoincrement())
  code String @unique(map: "sqlite_autoindex_company_companyservicecatalog_1")
  name String

  description String

  category String

  is_active Boolean

  sort_order Int

  created_at DateTime

  updated_at DateTime

  icon String?

  route String?

  companyServiceRequest CompanyServiceRequest[]

  companyServiceSubscription CompanyServiceSubscription[]

  companyTypeAllowedServices CompanyTypeAllowedServices[]

  @@map("company_companyservicecatalog")
}

model CompanyServiceRequest {
  id     Int    @id @default(autoincrement())
  status String

  requested_at DateTime

  reviewed_at DateTime?

  notes String

  meta String

  created_at DateTime

  updated_at DateTime

  company_id Int

  requested_by_id Int?

  reviewed_by_id Int?

  service_id Int

  image String?

  companyServiceCatalog                                         CompanyServiceCatalog @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_company_companyservicerequest_reviewed_by_idToauth_user  User?                 @relation("company_companyservicerequest_reviewed_by_idToauth_user", fields: [reviewed_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_company_companyservicerequest_requested_by_idToauth_user User?                 @relation("company_companyservicerequest_requested_by_idToauth_user", fields: [requested_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company                                                       Company               @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([service_id], map: "company_companyservicerequest_service_id_1dd7d95c")
  @@index([reviewed_by_id], map: "company_companyservicerequest_reviewed_by_id_1f4d7c95")
  @@index([requested_by_id], map: "company_companyservicerequest_requested_by_id_f6a1f43c")
  @@index([company_id], map: "company_companyservicerequest_company_id_77dcdfdd")
  @@map("company_companyservicerequest")
}

model CompanyServiceSubscription {
  id     Int    @id @default(autoincrement())
  status String

  requested_at DateTime?

  approved_at DateTime?

  activated_at DateTime?

  starts_at DateTime?

  ends_at DateTime?

  notes String

  meta String

  created_at DateTime

  updated_at DateTime

  approved_by_id Int?

  company_id Int

  requested_by_id Int?

  service_id Int

  companyServiceCatalog                                              CompanyServiceCatalog @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_company_companyservicesubscription_requested_by_idToauth_user User?                 @relation("company_companyservicesubscription_requested_by_idToauth_user", fields: [requested_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company                                                            Company               @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_company_companyservicesubscription_approved_by_idToauth_user  User?                 @relation("company_companyservicesubscription_approved_by_idToauth_user", fields: [approved_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([company_id, service_id], map: "company_companyservicesubscription_company_id_service_id_a53015a2_uniq")
  @@index([service_id], map: "company_companyservicesubscription_service_id_f0e5778c")
  @@index([requested_by_id], map: "company_companyservicesubscription_requested_by_id_4ad86781")
  @@index([company_id], map: "company_companyservicesubscription_company_id_99b2e479")
  @@index([approved_by_id], map: "company_companyservicesubscription_approved_by_id_f20c6bb8")
  @@map("company_companyservicesubscription")
}

model CompanySubscriptionRequest {
  id     Int    @id @default(autoincrement())
  status String

  notes String

  image String?

  created_at DateTime

  updated_at DateTime

  company_id Int

  requested_by_id Int?

  subscription_plan_id Int

  subscriptionPlan SubscriptionPlan @relation(fields: [subscription_plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user             User?            @relation(fields: [requested_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company          Company          @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([subscription_plan_id], map: "company_companysubscriptionrequest_subscription_plan_id_1c84406f")
  @@index([requested_by_id], map: "company_companysubscriptionrequest_requested_by_id_b33f0bbd")
  @@index([company_id], map: "company_companysubscriptionrequest_company_id_a3cf705d")
  @@map("company_companysubscriptionrequest")
}

model CompanyType {
  id         Int      @id @default(autoincrement())
  created_at DateTime

  name String

  ctype   String    @unique(map: "sqlite_autoindex_company_companytype_1")
  company Company[]

  companyTypeAllowedServices CompanyTypeAllowedServices[]

  companyType_allowed_subscription_plans company_companytype_allowed_subscription_plans[]

  @@map("company_companytype")
}

model CompanyTypeAllowedServices {
  id             Int @id @default(autoincrement())
  companytype_id Int

  companyservicecatalog_id Int

  companyServiceCatalog CompanyServiceCatalog @relation(fields: [companyservicecatalog_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companyType           CompanyType           @relation(fields: [companytype_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([companytype_id, companyservicecatalog_id], map: "company_companytype_allowed_services_companytype_id_companyservicecatalog_id_778ab4de_uniq")
  @@index([companyservicecatalog_id], map: "company_companytype_allowed_services_companyservicecatalog_id_14eb18dd")
  @@index([companytype_id], map: "company_companytype_allowed_services_companytype_id_04a7f6fc")
  @@map("company_companytype_allowed_services")
}

model company_companytype_allowed_subscription_plans {
  id             Int @id @default(autoincrement())
  companytype_id Int

  subscriptionplan_id Int

  subscriptionPlan SubscriptionPlan @relation(fields: [subscriptionplan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companyType      CompanyType      @relation(fields: [companytype_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

